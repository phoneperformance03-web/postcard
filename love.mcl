* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: sans-serif;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background: linear-gradient(135deg, #a8ff78, #78ffd6);
}

.card {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    text-align: center;
    width: 320px;
    position: relative;
}

.step-tag {
    background: #ff5e7e;
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    display: inline-block;
    margin-bottom: 15px;
}

.panda-img {
    width: 150px;
    height: 150px;
    object-fit: contain;
    margin-bottom: 15px;
}

h2 {
    font-size: 18px;
    color: #333;
    margin-bottom: 20px;
}

.btn-group {
    display: flex;
    justify-content: center;
    gap: 15px;
}

button {
    padding: 10px 25px;
    border: none;
    border-radius: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

#yesBtn {
    background: #ff4757;
    color: white;
}

#noBtn {
    background: #70a1ff;
    color: white;
    position: absolute;
}
